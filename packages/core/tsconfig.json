{
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": false,
    "target": "ESNext",
    "module": "ESNext",
    "outDir": "dist",
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
  "exclude": [
    "node_modules/**/*",
    "*.d.ts"
  ],
}